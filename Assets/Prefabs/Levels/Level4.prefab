--- !u!114 &6959236519225247195
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 6283750604119082534}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 074125836a4743089923e832e0f05920, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogue:
  - 'Robot: *Opens the safe*'
  - Robot:Oh my...
  - Robot:So many.. all dead.
  - Robot:Why did she go so far?! Even faking her own death...
  - Boss:Hey, hand that over!
  - Robot:This is not the real MS Drowning isnt it?
  - Boss:What? ... W-w-wwhat do you mean?
  - Robot:The real MS Drowning is somewhere down there!
  - Robot:And you are responsible! These files prove it.
  - Boss:...
  - Boss:I wanted to let you go after this job.
  - Boss:But this is off the table now....
  - Boss:What do i do.. shit shit shit...
  - Robot:ENOUGH!
  - Robot:First your shitty bike!
  - Robot:Then your radioactive waste!
  - Robot:Your appetite for drowned people!!
  - Robot:And all of this to cover up your crimes...
  - Robot:Time to end this. TIME TO END YOU!
  trigger: 2
--- !u!114 &3631170082412591346
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 6283750604119082534}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 074125836a4743089923e832e0f05920, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogue:
  - Robot:A safe down here? What secrets does my boss keep from me?
  - Robot:Oh there is something written on it...
  - Robot:...The MS Drowning files...
  - Robot:Wait thats the name of my bosses ship!
  - Robot:But this safe is to old for that.
  - Robot:I have to look into it before handing it over!
  trigger: 1
